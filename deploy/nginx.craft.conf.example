# nginx config for craft.rafter.com.cn
# Place dist/ contents at /var/www/craft.rafter.com.cn/

server {
    listen 80;
    server_name craft.rafter.com.cn;

    root /var/www/craft.rafter.com.cn;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json;
    gzip_min_length 256;
}

